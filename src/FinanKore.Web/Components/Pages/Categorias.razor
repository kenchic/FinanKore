@page "/finanzas/categorias"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Categorías - FinanKore</PageTitle>

<div class="tabla-container">
    <div class="tabla-header">
        <h3 class="tabla-titulo">
            <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-azul); vertical-align: middle;">category</span>
            Categorías
        </h3>
        <RadzenButton Text="Nueva Categoría" Click="@MostrarFormulario" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
    </div>
    <div class="tabla-body">
        @if (mostrandoFormulario)
        {
            <div style="padding: 1.5rem; max-width: 520px;">
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <RadzenLabel Text="Nombre" Component="NombreCat" />
                    <RadzenTextBox Name="NombreCat" @bind-Value="@modelo.Nombre" Placeholder="Nombre de la categoría" Style="width: 100%;" />

                    <RadzenLabel Text="Descripción" Component="DescCat" />
                    <RadzenTextArea Name="DescCat" @bind-Value="@modelo.Descripcion" Placeholder="Descripción (opcional)" Rows="3" Style="width: 100%;" />

                    <div style="display: flex; gap: 0.5rem;">
                        <RadzenButton Text="Guardar" Click="@HandleCrear" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="flex: 1;" />
                        <RadzenButton Text="Cancelar" Click="@CancelarFormulario" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Style="flex: 1;" />
                    </div>
                </div>
            </div>
        }
        else if (cargando)
        {
            <div style="text-align: center; padding: 2rem;">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                <p class="text-secondary" style="margin-top: 0.75rem;">Cargando categorías...</p>
            </div>
        }
        else if (categorias.Count == 0)
        {
            <div style="text-align: center; padding: 3rem;">
                <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">category</span>
                <p class="text-secondary" style="margin-top: 1rem;">No hay categorías aún. ¡Creá la primera!</p>
            </div>
        }
        else
        {
            <table class="rz-datatable" style="width: 100%;">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Fecha Creación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <span class="material-icons" style="color: var(--fk-azul); font-size: 1.25rem;">category</span>
                                    <strong>@categoria.Nombre</strong>
                                </div>
                            </td>
                            <td class="text-secondary">@categoria.Descripcion</td>
                            <td>@categoria.FechaCreacion.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<CategoriaCreadaDto> categorias = [];
    private bool cargando = true;
    private bool mostrandoFormulario;
    private CrearCategoriaModelo modelo = new() { Nombre = string.Empty, Descripcion = string.Empty };

    protected override async Task OnInitializedAsync() => await CargarCategorias();

    private async Task CargarCategorias()
    {
        cargando = true;
        try { categorias = await ServicioFinanzas.ObtenerCategoriasAsync(); }
        catch { categorias = []; }
        finally { cargando = false; }
    }

    private void MostrarFormulario()
    {
        modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
        mostrandoFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
    }

    private async Task HandleCrear()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "La categoría debe tener un nombre.", Duration = 4000 });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearCategoriaAsync(modelo);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = $"Categoría '{resultado?.Nombre}' creada", Detail = "La categoría se ha creado exitosamente.", Duration = 5000 });
            mostrandoFormulario = false;
            modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
            await CargarCategorias();
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al crear categoría", Detail = ex.Message, Duration = 5000 });
        }
    }
}
