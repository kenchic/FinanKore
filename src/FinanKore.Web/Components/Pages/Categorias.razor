@page "/finanzas/categorias"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Categorías - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem; padding: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <span class="material-icons" style="font-size: 2.5rem; color: var(--fk-azul);">category</span>
        <div style="flex: 1;">
            <h2 style="margin: 0;">Categorías</h2>
            <p class="text-secondary" style="margin: 0;">Gestión de categorías globales del sistema</p>
        </div>
        <RadzenButton Text="Nueva Categoría" Click="@MostrarFormulario" ButtonStyle="@ButtonStyle.Primary" />
    </div>
</div>

@if (mostrandoFormulario)
{
    <div class="gx-card" style="padding: 2rem; max-width: 520px;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <span class="material-icons" style="font-size: 3rem; color: var(--rz-primary);">add_circle</span>
            <h3 style="margin: 0.5rem 0 0.25rem;">Nueva Categoría</h3>
            <p style="color: var(--rz-text-secondary); margin: 0;">
                Crear una categoría disponible para todos los proyectos
            </p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <RadzenTextBox @bind-Value="@modelo.Nombre"
                           Placeholder="Nombre de la categoría"
                           Style="width: 100%;" />

            <RadzenTextArea @bind-Value="@modelo.Descripcion"
                            Placeholder="Descripción (opcional)"
                            Rows="3"
                            Style="width: 100%;" />

            <div style="display: flex; gap: 0.5rem;">
                <RadzenButton Text="Guardar"
                              Click="@HandleCrear"
                              ButtonStyle="@ButtonStyle.Primary"
                              Size="@ButtonSize.Medium"
                              Style="flex: 1;" />
                <RadzenButton Text="Cancelar"
                              Click="@CancelarFormulario"
                              ButtonStyle="@ButtonStyle.Secondary"
                              Size="@ButtonSize.Medium"
                              Style="flex: 1;" />
            </div>
        </div>
    </div>
}
else if (cargando)
{
    <div class="gx-card" style="text-align: center; padding: 2rem;">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
        <p class="text-secondary" style="margin-top: 0.75rem;">Cargando categorías...</p>
    </div>
}
else if (categorias.Count == 0)
{
    <div class="gx-card" style="text-align: center; padding: 3rem;">
        <span class="material-icons" style="font-size: 3rem; color: var(--rz-text-secondary-color, #bbb);">inbox</span>
        <p class="text-secondary" style="margin-top: 1rem;">No hay categorías aún. ¡Creá la primera!</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        @foreach (var categoria in categorias)
        {
            <div class="gx-card categoria-fila">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span class="material-icons" style="color: var(--fk-azul);">category</span>
                    <div style="flex: 1;">
                        <strong>@categoria.Nombre</strong>
                        @if (!string.IsNullOrWhiteSpace(categoria.Descripcion))
                        {
                            <p class="text-secondary" style="margin: 0.25rem 0 0; font-size: 0.85rem;">@categoria.Descripcion</p>
                        }
                    </div>
                    <span style="font-size: 0.8rem; color: var(--rz-text-secondary-color, #aaa);">
                        @categoria.FechaCreacion.ToString("dd/MM/yyyy")
                    </span>
                </div>
            </div>
        }
    </div>
}

<div style="text-align: left; margin-top: 1rem;">
    <RadzenButton Text="Volver al inicio"
                  ButtonStyle="@ButtonStyle.Secondary"
                  Size="@ButtonSize.Small"
                  Click="@IrAInicio" />
</div>

<style>
.categoria-fila {
    padding: 1rem 1.5rem;
    transition: box-shadow 0.2s ease;
}
.categoria-fila:hover {
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.08);
}
</style>

@code {
    private List<CategoriaCreadaDto> categorias = [];
    private bool cargando = true;
    private bool mostrandoFormulario;
    private CrearCategoriaModelo modelo = new() { Nombre = string.Empty, Descripcion = string.Empty };

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        try
        {
            categorias = await ServicioFinanzas.ObtenerCategoriasAsync();
        }
        catch
        {
            categorias = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarFormulario()
    {
        modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
        mostrandoFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
    }

    private async Task HandleCrear()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Nombre obligatorio",
                Detail = "La categoría debe tener un nombre.",
                Duration = 4000
            });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearCategoriaAsync(modelo);

            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Categoría '{resultado?.Nombre}' creada",
                Detail = "La categoría se ha creado exitosamente.",
                Duration = 5000
            });

            mostrandoFormulario = false;
            modelo = new CrearCategoriaModelo { Nombre = string.Empty, Descripcion = string.Empty };
            await CargarCategorias();
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al crear categoría",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void IrAInicio()
    {
        Navegacion.NavigateTo("/");
    }
}
