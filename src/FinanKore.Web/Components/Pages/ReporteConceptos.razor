@page "/finanzas/reportes/{reporteId:guid}/conceptos"
@rendermode InteractiveServer
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Conceptos del Reporte - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem; padding: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <span class="material-icons" style="font-size: 2.5rem; color: var(--fk-violeta);">receipt_long</span>
        <div style="flex: 1;">
            <h2 style="margin: 0;">Reporte: @nombreReporte</h2>
            <p class="text-secondary" style="margin: 0;">Matriz de conceptos por categoría</p>
        </div>
        <RadzenButton Text="Agregar Concepto"
                      Click="@AbrirModal"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small" />
        <RadzenButton Text="Volver"
                      Click="@VolverAReportes"
                      ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.Small" />
    </div>
</div>

@if (modalVisible)
{
    <div class="modal-backdrop" @onclick="CerrarModal"></div>
    <div class="gx-card modal-panel">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <span class="material-icons" style="font-size: 2rem; color: var(--fk-violeta);">add_circle</span>
            <h3 style="margin: 0;">Nuevo Concepto</h3>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Nombre</label>
                <RadzenTextBox @bind-Value="@modelo.Nombre"
                               Placeholder="Nombre del concepto"
                               Style="width: 100%;" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Valor</label>
                <RadzenNumeric @bind-Value="@modelo.Valor"
                               Placeholder="Valor"
                               Min="0"
                               Format="c"
                               Style="width: 100%;" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Tipo de Movimiento</label>
                <RadzenDropDown Data="@tiposMovimiento"
                                TextProperty="Texto"
                                ValueProperty="Valor"
                                @bind-Value="@modelo.Tipo"
                                Placeholder="Seleccionar tipo..."
                                Style="width: 100%;" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Categoría</label>
                <RadzenDropDown Data="@categorias"
                                TextProperty="Nombre"
                                ValueProperty="Id"
                                @bind-Value="@modelo.CategoriaId"
                                Placeholder="Seleccionar categoría..."
                                Style="width: 100%;" />
            </div>

            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <RadzenButton Text="Guardar"
                              Click="@GuardarConcepto"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Medium"
                              Style="flex: 1;" />
                <RadzenButton Text="Cancelar"
                              Click="@CerrarModal"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="flex: 1;" />
            </div>
        </div>
    </div>
}

@if (modalEditarVisible)
{
    <div class="modal-backdrop" @onclick="CerrarModalEditar"></div>
    <div class="gx-card modal-panel">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <span class="material-icons" style="font-size: 2rem; color: var(--fk-violeta);">edit</span>
            <h3 style="margin: 0;">Editar Concepto</h3>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Nombre</label>
                <RadzenTextBox @bind-Value="@modeloEditar.Nombre"
                               Style="width: 100%;" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Valor</label>
                <RadzenNumeric @bind-Value="@modeloEditar.Valor"
                               Min="0"
                               Style="width: 100%;" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Tipo de Movimiento</label>
                <span class="text-secondary" style="display: block; padding: 0.5rem 0; font-size: 0.95rem;">@modeloEditarTipoTexto</span>
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem;">Categoría</label>
                <span class="text-secondary" style="display: block; padding: 0.5rem 0; font-size: 0.95rem;">@modeloEditarCategoriaNombre</span>
            </div>

            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <RadzenButton Text="Guardar"
                              Click="@GuardarEdicion"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Medium"
                              Style="flex: 1;" />
                <RadzenButton Text="Cancelar"
                              Click="@CerrarModalEditar"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="flex: 1;" />
            </div>
        </div>
    </div>
}

@if (cargando)
{
    <div class="gx-card" style="text-align: center; padding: 2rem;">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
        <p class="text-secondary" style="margin-top: 0.75rem;">Cargando conceptos...</p>
    </div>
}
else if (conceptos.Count == 0)
{
    <div class="gx-card" style="text-align: center; padding: 3rem;">
        <span class="material-icons" style="font-size: 3rem; color: var(--rz-text-secondary-color, #bbb);">inbox</span>
        <p class="text-secondary" style="margin-top: 1rem;">No hay conceptos en este reporte. ¡Agregá el primero!</p>
    </div>
}
else
{
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <!-- Tabla de Totales por Categoría -->
        <div class="gx-card" style="padding: 1rem; overflow-x: auto; flex: 0 0 auto;">
            <table class="tabla-conceptos">
                <thead>
                    <tr>
                        <th class="th-concepto">Reporte</th>
                        <th class="th-categoria">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in categoriasUsadas)
                    {
                        var total = CalcularTotalPorCategoria(categoria.Id);
                        <tr>
                            <td class="td-concepto">@categoria.Nombre</td>
                            <td class="td-valor">
                                @if (total >= 0)
                                {
                                    <span class="valor-entrada">$ @total.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="valor-salida">$ (@Math.Abs(total).ToString("N0"))</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr style="border-top: 2px solid #333;">
                        <td class="td-concepto" style="font-weight: 700;">Saldo</td>
                        <td class="td-valor" style="font-weight: 700;">
                            @if (saldoTotal >= 0)
                            {
                                <span class="valor-entrada">$ @saldoTotal.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="valor-salida">$ (@Math.Abs(saldoTotal).ToString("N0"))</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Tabla de Detalle: Conceptos x Categorías -->
        <div class="gx-card" style="padding: 1rem; overflow-x: auto; flex: 1; min-width: 400px;">
            <table class="tabla-conceptos">
                <thead>
                    <tr>
                        <th class="th-concepto">Reporte</th>
                        @foreach (var categoria in categoriasUsadas)
                        {
                            <th class="th-categoria">@categoria.Nombre</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var concepto in conceptos)
                    {
                        <tr>
                            <td class="td-concepto">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span class="material-icons" style="font-size: 1.1rem; color: @(concepto.Tipo == 1 ? "var(--fk-verde)" : "var(--fk-magenta)");">
                                        @(concepto.Tipo == 1 ? "trending_up" : "trending_down")
                                    </span>
                                    <span>@concepto.Nombre</span>
                                </div>
                            </td>
                            @foreach (var categoria in categoriasUsadas)
                            {
                            <td class="td-valor">
                                @if (concepto.CategoriaId == categoria.Id)
                                {
                                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem;">
                                        @if (concepto.Tipo == 1)
                                        {
                                            <span class="valor-entrada">$ @concepto.Valor.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="valor-salida">$ (@concepto.Valor.ToString("N0"))</span>
                                        }
                                        <button type="button"
                                                class="btn-icono-concepto"
                                                @onclick="() => AbrirModalEditar(concepto)"
                                                title="Editar concepto"
                                                style="border: none; background: none; cursor: pointer; padding: 0.25rem; display: inline-flex; align-items: center; justify-content: center; opacity: 0.6; transition: opacity 0.2s;"
                                                onmouseover="this.style.opacity='1'"
                                                onmouseout="this.style.opacity='0.6'">
                                            <span class="material-icons" style="font-size: 1rem; color: var(--fk-violeta);">edit</span>
                                        </button>
                                        <button type="button"
                                                class="btn-icono-concepto"
                                                @onclick="() => CancelarConcepto(concepto.Id)"
                                                title="Cancelar concepto (poner en cero)"
                                                style="border: none; background: none; cursor: pointer; padding: 0.25rem; display: inline-flex; align-items: center; justify-content: center; opacity: 0.6; transition: opacity 0.2s;"
                                                onmouseover="this.style.opacity='1'"
                                                onmouseout="this.style.opacity='0.6'">
                                            <span class="material-icons" style="font-size: 1rem; color: var(--fk-magenta);">cancel</span>
                                        </button>
                                    </div>
                                }
                            </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1000;
    }

    .modal-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
        width: 90%;
        max-width: 480px;
        padding: 2rem;
    }

    .tabla-conceptos {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .tabla-conceptos th,
    .tabla-conceptos td {
        border: 1px solid #e0e0e0;
        padding: 0.6rem 0.8rem;
        text-align: left;
    }

    .tabla-conceptos thead th {
        background: #f8f9fa;
        font-weight: 600;
        color: #444;
        white-space: nowrap;
    }

    .th-concepto {
        min-width: 200px;
    }

    .th-categoria {
        min-width: 120px;
    }

    .td-concepto {
        font-weight: 500;
        background: #fafafa;
    }

    .td-valor {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .valor-entrada {
        color: #2e7d32;
        font-weight: 600;
    }

    .valor-salida {
        color: #c62828;
        font-weight: 600;
    }

    .tabla-conceptos tbody tr:hover td {
        background: #f5f5f5;
    }

    .btn-icono-concepto:hover {
        opacity: 1;
    }
</style>

@code {
    [Parameter] public Guid ReporteId { get; set; }

    private List<ConceptoReporteDto> conceptos = [];
    private List<CategoriaCreadaDto> categorias = [];
    private List<CategoriaCreadaDto> categoriasUsadas = [];
    private string nombreReporte = string.Empty;
    private bool cargando = true;
    private bool modalVisible = false;
    private bool modalEditarVisible = false;
    private CrearConceptoReporteModelo modelo = new() { Nombre = string.Empty, Valor = 0, Tipo = 1 };
    private CrearConceptoReporteModelo modeloEditar = new() { Nombre = string.Empty, Valor = 0, Tipo = 1 };
    private string modeloEditarTipoTexto = string.Empty;
    private string modeloEditarCategoriaNombre = string.Empty;
    private Guid conceptoEditandoId = Guid.Empty;
    private decimal saldoTotal = 0;

    private List<TipoMovimientoOpcion> tiposMovimiento =
    [
        new(1, "Entrada"),
        new(2, "Salida")
    ];

    protected override async Task OnInitializedAsync()
    {
        modelo.ReporteId = ReporteId;
        await CargarReporte();
        await CargarCategorias();
        await CargarConceptos();
    }

    private async Task CargarReporte()
    {
        try
        {
            var reportes = await ServicioFinanzas.ObtenerTodosLosReportesAsync();
            var reporte = reportes.FirstOrDefault(r => r.Id == ReporteId);
            nombreReporte = reporte?.ReporteNombre ?? "Reporte";
        }
        catch
        {
            nombreReporte = "Reporte";
        }
    }

    private async Task CargarCategorias()
    {
        try
        {
            categorias = await ServicioFinanzas.ObtenerCategoriasAsync();
        }
        catch
        {
            categorias = [];
        }
    }

    private async Task CargarConceptos()
    {
        cargando = true;
        try
        {
            conceptos = await ServicioFinanzas.ObtenerConceptosPorReporteAsync(ReporteId);
            CalcularCategoriasUsadas();
            CalcularSaldo();
        }
        catch
        {
            conceptos = [];
            categoriasUsadas = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private void CalcularCategoriasUsadas()
    {
        var idsUsados = conceptos.Select(c => c.CategoriaId).Distinct().ToList();
        categoriasUsadas = categorias
            .Where(c => idsUsados.Contains(c.Id))
            .OrderBy(c => c.Nombre)
            .ToList();
    }

    private decimal CalcularTotalPorCategoria(Guid categoriaId)
    {
        var conceptosCat = conceptos.Where(c => c.CategoriaId == categoriaId);
        var entradas = conceptosCat.Where(c => c.Tipo == 1).Sum(c => c.Valor);
        var salidas = conceptosCat.Where(c => c.Tipo == 2).Sum(c => c.Valor);
        return entradas - salidas;
    }

    private void CalcularSaldo()
    {
        var entradas = conceptos.Where(c => c.Tipo == 1).Sum(c => c.Valor);
        var salidas = conceptos.Where(c => c.Tipo == 2).Sum(c => c.Valor);
        saldoTotal = entradas - salidas;
    }

    private void AbrirModal()
    {
        modelo = new CrearConceptoReporteModelo
        {
            ReporteId = ReporteId,
            Nombre = string.Empty,
            Valor = 0,
            Tipo = 1,
            CategoriaId = Guid.Empty
        };
        modalVisible = true;
    }

    private void CerrarModal()
    {
        modalVisible = false;
    }

    private async Task GuardarConcepto()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Nombre obligatorio",
                Detail = "El concepto debe tener un nombre.",
                Duration = 4000
            });
            return;
        }

        if (modelo.Valor <= 0)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Valor inválido",
                Detail = "El valor debe ser mayor a cero.",
                Duration = 4000
            });
            return;
        }

        if (modelo.CategoriaId == Guid.Empty)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Categoría obligatoria",
                Detail = "Debés seleccionar una categoría.",
                Duration = 4000
            });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearConceptoReporteAsync(modelo);

            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Concepto '{resultado?.Nombre}' creado",
                Detail = "El concepto se ha creado exitosamente.",
                Duration = 5000
            });

            modalVisible = false;
            await CargarConceptos();
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al crear concepto",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task CancelarConcepto(Guid conceptoId)
    {
        try
        {
            await ServicioFinanzas.CancelarConceptoAsync(ReporteId, conceptoId);

            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Concepto cancelado",
                Detail = "El valor del concepto ha sido puesto en cero.",
                Duration = 4000
            });

            await CargarConceptos();
        }
        catch (Exception ex)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al cancelar concepto",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void AbrirModalEditar(ConceptoReporteDto concepto)
    {
        conceptoEditandoId = concepto.Id;
        modeloEditar = new CrearConceptoReporteModelo
        {
            ReporteId = concepto.ReporteId,
            Nombre = concepto.Nombre,
            Valor = concepto.Valor,
            Tipo = concepto.Tipo,
            CategoriaId = concepto.CategoriaId
        };

        modeloEditarTipoTexto = concepto.Tipo == 1 ? "Entrada" : "Salida";
        modeloEditarCategoriaNombre = categorias
            .FirstOrDefault(c => c.Id == concepto.CategoriaId)?.Nombre ?? "Sin categoría";

        modalEditarVisible = true;
    }

    private void CerrarModalEditar()
    {
        modalEditarVisible = false;
    }

    private async Task GuardarEdicion()
    {
        if (string.IsNullOrWhiteSpace(modeloEditar.Nombre))
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Nombre obligatorio",
                Detail = "El concepto debe tener un nombre.",
                Duration = 4000
            });
            return;
        }

        if (modeloEditar.Valor < 0)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Valor inválido",
                Detail = "El valor no puede ser negativo.",
                Duration = 4000
            });
            return;
        }

        try
        {
            await ServicioFinanzas.EditarConceptoAsync(
                ReporteId,
                conceptoEditandoId,
                modeloEditar.Nombre,
                modeloEditar.Valor);

            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Concepto actualizado",
                Detail = $"'{modeloEditar.Nombre}' se ha actualizado correctamente.",
                Duration = 4000
            });

            modalEditarVisible = false;
            await CargarConceptos();
        }
        catch (Exception ex)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al actualizar concepto",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void VolverAReportes()
    {
        Navegacion.NavigateTo("/finanzas/reportes");
    }

    private sealed record TipoMovimientoOpcion(int Valor, string Texto);
}
