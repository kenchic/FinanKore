@page "/finanzas/reportes/{reporteId:guid}/conceptos"
@rendermode InteractiveServer
@using FinanKore.Aplicacion.Proyecto.Dtos
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Conceptos del Reporte - FinanKore</PageTitle>

<div class="tabla-container">
    <div class="tabla-header">
        <h3 class="tabla-titulo">
            <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-violeta); vertical-align: middle;">receipt_long</span>
            @nombreReporte
        </h3>
        <RadzenButton Text="Agregar Concepto" Click="@AbrirModal" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
    </div>
    <div class="tabla-body">
        @if (modalVisible)
        {
            <div class="fk-modal-overlay" @onclick="CerrarModal">
                <div class="fk-modal" @onclick:stopPropagation="true">
                    <div class="fk-modal-header">
                        <span class="material-icons" style="color: var(--fk-violeta);">add_circle</span>
                        <strong>Agregar Concepto</strong>
                    </div>
                    <div class="fk-modal-body">
                        <RadzenLabel Text="Nombre" Component="NombreCon" />
                        <RadzenTextBox Name="NombreCon" @bind-Value="@modelo.Nombre" Placeholder="Nombre del concepto" Style="width: 100%;" />

                        <RadzenLabel Text="Valor" Component="ValorCon" />
                        <RadzenNumeric Name="ValorCon" @bind-Value="@modelo.Valor" Min="0" Format="c" Style="width: 100%;" />

                        <RadzenLabel Text="Tipo" Component="TipoCon" />
                        <RadzenDropDown Name="TipoCon" Data="@tiposMovimiento" TextProperty="Texto" ValueProperty="Valor" @bind-Value="@modelo.Tipo" Placeholder="Seleccionar tipo..." Style="width: 100%;" />

                        <RadzenLabel Text="Categoría" Component="CatCon" />
                        <RadzenDropDown Name="CatCon" Data="@categorias" TextProperty="Nombre" ValueProperty="Id" @bind-Value="@modelo.CategoriaId" Placeholder="Seleccionar categoría..." Style="width: 100%;" />

                        <div class="fk-modal-actions">
                            <RadzenButton Text="Guardar" Click="@GuardarConcepto" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="flex: 1;" />
                            <RadzenButton Text="Cancelar" Click="@CerrarModal" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Style="flex: 1;" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (modalEditarVisible)
        {
            <div class="fk-modal-overlay" @onclick="CerrarModalEditar">
                <div class="fk-modal" @onclick:stopPropagation="true">
                    <div class="fk-modal-header">
                        <span class="material-icons" style="color: var(--fk-violeta);">edit</span>
                        <strong>Editar Concepto</strong>
                    </div>
                    <div class="fk-modal-body">
                        <div>
                            <div class="fk-modal-sublabel">Concepto</div>
                            <div class="fk-modal-subvalue">@modeloEditar.Nombre</div>
                        </div>

                        <div>
                            <RadzenLabel Text="Valor" Component="ValorEdit" />
                            <RadzenNumeric Name="ValorEdit" @bind-Value="@modeloEditar.Valor" Min="0" Style="width: 100%;" />
                        </div>

                        <div class="fk-modal-actions">
                            <RadzenButton Text="Guardar" Click="@GuardarEdicion" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="flex: 1;" />
                            <RadzenButton Text="Cancelar" Click="@CerrarModalEditar" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Style="flex: 1;" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (modalConfirmarEliminarVisible)
        {
            <div class="fk-modal-overlay fk-modal-overlay-danger" @onclick="CerrarModalConfirmarEliminar">
                <div class="fk-modal fk-modal-narrow" @onclick:stopPropagation="true">
                    <div class="fk-modal-header">
                        <span class="material-icons" style="color: #ef4444;">warning</span>
                        <strong>Confirmar eliminación</strong>
                    </div>
                    <p class="fk-modal-danger-text">
                        ¿Estás seguro de eliminar el concepto <strong>@conceptoEliminandoNombre</strong>?
                    </p>
                    <div class="fk-modal-actions">
                        <RadzenButton Text="Eliminar" Click="@ConfirmarEliminar" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Style="flex: 1;" />
                        <RadzenButton Text="Cancelar" Click="@CerrarModalConfirmarEliminar" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Style="flex: 1;" />
                    </div>
                </div>
            </div>
        }

        @if (cargando)
        {
            <div style="text-align: center; padding: 2rem;">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                <p class="text-secondary" style="margin-top: 0.75rem;">Cargando conceptos...</p>
            </div>
        }
        else if (conceptos.Count == 0)
        {
            <div style="text-align: center; padding: 3rem;">
                <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">receipt_long</span>
                <p class="text-secondary" style="margin-top: 1rem;">No hay conceptos en este reporte. ¡Agregá el primero!</p>
            </div>
        }
        else
        {
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div style="flex: 0 0 auto; min-width: 200px;">
                    <table>
                        <thead>
                            <tr>
                                <th>Categoría</th>
                                <th style="text-align: right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var categoria in categoriasUsadas)
                            {
                                var total = CalcularTotalPorCategoria(categoria.Id);
                                <tr>
                                    <td>@categoria.Nombre</td>
                                    <td style="text-align: right;">
                                        @if (total >= 0)
                                        {
                                            <span style="color: var(--fk-verde);">$ @total.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--fk-magenta);">$ (@Math.Abs(total).ToString("N0"))</span>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr style="border-top: 2px solid #333;">
                                <td style="font-weight: 700;">Saldo</td>
                                <td style="text-align: right; font-weight: 700;">
                                    @if (saldoTotal >= 0)
                                    {
                                        <span style="color: var(--fk-verde);">$ @saldoTotal.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--fk-magenta);">$ (@Math.Abs(saldoTotal).ToString("N0"))</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="flex: 1; min-width: 480px; overflow-x: auto;">
                    <div class="pestanas-categorias pestanas-categorias-violeta">
                        @foreach (var cat in categoriasUsadas)
                        {
                            <button type="button"
                                    class="pestana-categoria @(cat.Id == categoriaActivaId ? "activa" : "")"
                                    @onclick="@(() => categoriaActivaId = cat.Id)">
                                <span class="material-icons" style="font-size: 0.95rem;">label</span>
                                @cat.Nombre
                                <span class="badge-conteo">@conceptos.Count(c => c.CategoriaId == cat.Id)</span>
                            </button>
                        }
                    </div>
                    <div class="pestana-contenido">
                        @{
                            var conceptosDeCat = conceptos.Where(c => c.CategoriaId == categoriaActivaId).OrderBy(c => c.Nombre).ToList();
                            var totalCat = conceptosDeCat.Sum(c => c.Tipo == 1 ? c.Valor : -c.Valor);
                        }
                        @if (conceptosDeCat.Count == 0)
                        {
                            <div style="text-align: center; padding: 2rem;">
                                <span class="material-icons" style="font-size: 2rem; color: #d1d5db;">label_off</span>
                                <p class="text-secondary">Esta categoría no tiene conceptos.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th style="text-align: left;">Concepto</th>
                                        <th style="text-align: right;">Valor</th>
                                        <th style="text-align: right;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in conceptosDeCat)
                                    {
                                        <tr>
                                            <td style="text-align: left; font-weight: 500;">@c.Nombre</td>
                                            <td style="text-align: right; white-space: nowrap;">
                                                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.35rem;">
                                                    <span class="material-icons" style="font-size: 0.85rem; color: @(c.Tipo == 1 ? "var(--fk-verde)" : "var(--fk-magenta)");">
                                                        @(c.Tipo == 1 ? "trending_up" : "trending_down")
                                                    </span>
                                                    @if (c.Tipo == 1)
                                                    {
                                                        <span style="color: var(--fk-verde);">$ @c.Valor.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: var(--fk-magenta);">$ (@c.Valor.ToString("N0"))</span>
                                                    }
                                                </div>
                                            </td>
                                            <td style="text-align: right; white-space: nowrap;">
                                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Class="btn-tabla" Click="@(() => AbrirModalEditar(c))" title="Editar" />
                                                <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Class="btn-tabla" Click="@(() => CancelarConcepto(c.Id))" title="Cancelar" />
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Class="btn-tabla" Click="@(() => AbrirModalConfirmarEliminar(c))" title="Eliminar" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr style="border-top: 2px solid var(--fk-gris-borde); font-weight: 600;">
                                        <td style="text-align: left;">Total</td>
                                        <td style="text-align: right; color: @(totalCat >= 0 ? "var(--fk-verde)" : "var(--fk-magenta)");">$ @Math.Abs(totalCat).ToString("N0")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ReporteId { get; set; }

    private List<ConceptoReporteDto> conceptos = [];
    private Guid categoriaActivaId;
    private List<CategoriaCreadaDto> categorias = [];
    private List<CategoriaCreadaDto> categoriasUsadas = [];
    private string nombreReporte = string.Empty;
    private bool cargando = true;
    private bool modalVisible = false;
    private bool modalEditarVisible = false;
    private bool modalConfirmarEliminarVisible = false;
    private CrearConceptoReporteModelo modelo = new() { Nombre = string.Empty, Valor = 0, Tipo = 1 };
    private CrearConceptoReporteModelo modeloEditar = new() { Nombre = string.Empty, Valor = 0 };
    private Guid conceptoEditandoId = Guid.Empty;
    private Guid conceptoEliminandoId = Guid.Empty;
    private string conceptoEliminandoNombre = string.Empty;
    private decimal saldoTotal = 0;

    private List<TipoMovimientoOpcion> tiposMovimiento = [new(1, "Entrada"), new(2, "Salida")];

    protected override async Task OnInitializedAsync()
    {
        modelo.ReporteId = ReporteId;
        await CargarReporte();
        await CargarCategorias();
        await CargarConceptos();
    }

    private async Task CargarReporte()
    {
        try
        {
            var reportes = await ServicioFinanzas.ObtenerTodosLosReportesAsync();
            var reporte = reportes.FirstOrDefault(r => r.Id == ReporteId);
            nombreReporte = reporte?.ReporteNombre ?? "Reporte";
        }
        catch { nombreReporte = "Reporte"; }
    }

    private async Task CargarCategorias()
    {
        try { categorias = await ServicioFinanzas.ObtenerCategoriasAsync(); }
        catch { categorias = []; }
    }

    private async Task CargarConceptos()
    {
        cargando = true;
        try
        {
            conceptos = await ServicioFinanzas.ObtenerConceptosPorReporteAsync(ReporteId);
            CalcularCategoriasUsadas();
            CalcularSaldo();
            if (categoriaActivaId == Guid.Empty || !categoriasUsadas.Any(c => c.Id == categoriaActivaId))
                categoriaActivaId = categoriasUsadas.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch { conceptos = []; categoriasUsadas = []; categoriaActivaId = Guid.Empty; }
        finally { cargando = false; }
    }

    private void CalcularCategoriasUsadas()
    {
        var idsUsados = conceptos.Select(c => c.CategoriaId).Distinct().ToList();
        categoriasUsadas = categorias.Where(c => idsUsados.Contains(c.Id)).OrderBy(c => c.Nombre).ToList();
    }

    private decimal CalcularTotalPorCategoria(Guid categoriaId)
    {
        var conceptosCat = conceptos.Where(c => c.CategoriaId == categoriaId);
        var entradas = conceptosCat.Where(c => c.Tipo == 1).Sum(c => c.Valor);
        var salidas = conceptosCat.Where(c => c.Tipo == 2).Sum(c => c.Valor);
        return entradas - salidas;
    }

    private void CalcularSaldo()
    {
        var entradas = conceptos.Where(c => c.Tipo == 1).Sum(c => c.Valor);
        var salidas = conceptos.Where(c => c.Tipo == 2).Sum(c => c.Valor);
        saldoTotal = entradas - salidas;
    }

    private void AbrirModal()
    {
        modelo = new CrearConceptoReporteModelo { ReporteId = ReporteId, Nombre = string.Empty, Valor = 0, Tipo = 1, CategoriaId = Guid.Empty };
        modalVisible = true;
    }

    private void CerrarModal() => modalVisible = false;

    private async Task GuardarConcepto()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "El concepto debe tener un nombre.", Duration = 4000 });
            return;
        }
        if (modelo.Valor <= 0)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Valor inválido", Detail = "El valor debe ser mayor a cero.", Duration = 4000 });
            return;
        }
        if (modelo.CategoriaId == Guid.Empty)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Categoría obligatoria", Detail = "Debés seleccionar una categoría.", Duration = 4000 });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearConceptoReporteAsync(modelo);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = $"Concepto '{resultado?.Nombre}' creado", Detail = "El concepto se ha creado exitosamente.", Duration = 5000 });
            modalVisible = false;
            await CargarConceptos();
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al crear concepto", Detail = ex.Message, Duration = 5000 });
        }
    }

    private async Task CancelarConcepto(Guid conceptoId)
    {
        try
        {
            await ServicioFinanzas.CancelarConceptoAsync(ReporteId, conceptoId);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Concepto cancelado", Detail = "El valor del concepto ha sido puesto en cero.", Duration = 4000 });
            await CargarConceptos();
        }
        catch (Exception ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al cancelar concepto", Detail = ex.Message, Duration = 5000 });
        }
    }

    private void AbrirModalEditar(ConceptoReporteDto concepto)
    {
        conceptoEditandoId = concepto.Id;
        modeloEditar = new CrearConceptoReporteModelo { ReporteId = concepto.ReporteId, Nombre = concepto.Nombre, Valor = concepto.Valor, Tipo = concepto.Tipo, CategoriaId = concepto.CategoriaId };
        modalEditarVisible = true;
    }

    private void CerrarModalEditar() => modalEditarVisible = false;

    private async Task GuardarEdicion()
    {
        if (string.IsNullOrWhiteSpace(modeloEditar.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "El concepto debe tener un nombre.", Duration = 4000 });
            return;
        }
        if (modeloEditar.Valor < 0)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Valor inválido", Detail = "El valor no puede ser negativo.", Duration = 4000 });
            return;
        }

        try
        {
            await ServicioFinanzas.EditarConceptoAsync(ReporteId, conceptoEditandoId, modeloEditar.Nombre, modeloEditar.Valor);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Concepto actualizado", Detail = $"'{modeloEditar.Nombre}' se ha actualizado correctamente.", Duration = 4000 });
            modalEditarVisible = false;
            await CargarConceptos();
        }
        catch (Exception ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al actualizar concepto", Detail = ex.Message, Duration = 5000 });
        }
    }

    private void AbrirModalConfirmarEliminar(ConceptoReporteDto concepto)
    {
        conceptoEliminandoId = concepto.Id;
        conceptoEliminandoNombre = concepto.Nombre;
        modalConfirmarEliminarVisible = true;
    }

    private void CerrarModalConfirmarEliminar() => modalConfirmarEliminarVisible = false;

    private async Task ConfirmarEliminar()
    {
        try
        {
            await ServicioFinanzas.EliminarConceptoReporteAsync(ReporteId, conceptoEliminandoId);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Concepto eliminado", Detail = $"'{conceptoEliminandoNombre}' fue eliminado.", Duration = 4000 });
            modalConfirmarEliminarVisible = false;
            await CargarConceptos();
        }
        catch (Exception ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al eliminar concepto", Detail = ex.Message, Duration = 5000 });
        }
    }

    private sealed record TipoMovimientoOpcion(int Valor, string Texto);
}
