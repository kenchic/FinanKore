@page "/"
@rendermode InteractiveServer
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NavigationManager Navegacion
@inject ProtectedSessionStorage AlmacenamientoSesion
@inject EstadoAutenticacion Estado

<PageTitle>FinanKore - Panel</PageTitle>

@if (cargando)
{
    <div class="gx-card" style="text-align: center; padding: 3rem;">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 48px; height: 48px;" />
        <p class="text-secondary" style="margin-top: 1rem;">Cargando...</p>
    </div>
}
else if (usuario is not null)
{
    <div class="kpi-grid">
        <div class="kpi-card" @onclick="() => IrAProyectos()">
            <div class="kpi-icon kpi-icon-magenta">
                <span class="material-icons">folder</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Proyectos</div>
                <div class="kpi-value">@totalProyectos</div>
                <div class="kpi-subtitle">Proyectos activos</div>
            </div>
        </div>

        <div class="kpi-card" @onclick="() => IrACategorias()">
            <div class="kpi-icon kpi-icon-azul">
                <span class="material-icons">category</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Categorías</div>
                <div class="kpi-value">@totalCategorias</div>
                <div class="kpi-subtitle">Categorías configuradas</div>
            </div>
        </div>

        <div class="kpi-card" @onclick="() => IrAReportes()">
            <div class="kpi-icon kpi-icon-violeta">
                <span class="material-icons">bar_chart</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Reportes</div>
                <div class="kpi-value">@totalReportes</div>
                <div class="kpi-subtitle">Reportes generados</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-icon-verde">
                <span class="material-icons">trending_up</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Balance</div>
                <div class="kpi-value">@balanceTotal</div>
                <div class="kpi-subtitle">Entradas - Salidas</div>
            </div>
        </div>
    </div>

    <div class="chart-grid">
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">Ingresos vs Egresos</h3>
                <div class="chart-legend">
                    <div class="chart-legend-item">
                        <div class="chart-legend-dot" style="background: var(--fk-verde);"></div>
                        <span>Ingresos</span>
                    </div>
                    <div class="chart-legend-item">
                        <div class="chart-legend-dot" style="background: var(--fk-magenta);"></div>
                        <span>Egresos</span>
                    </div>
                </div>
            </div>
            <div class="chart-placeholder">
                <span class="material-icons">show_chart</span>
                <span class="chart-placeholder-text">Gráfico de líneas - Próximamente</span>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">Distribución por Categoría</h3>
                <div class="chart-legend">
                    <div class="chart-legend-item">
                        <div class="chart-legend-dot" style="background: var(--fk-azul);"></div>
                        <span>Categorías</span>
                    </div>
                </div>
            </div>
            <div class="chart-placeholder">
                <span class="material-icons">pie_chart</span>
                <span class="chart-placeholder-text">Gráfico circular - Próximamente</span>
            </div>
        </div>
    </div>

    <div class="tabla-container">
        <div class="tabla-header">
            <h3 class="tabla-titulo">Proyectos Recientes</h3>
            <RadzenButton Text="Ver Todos"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Click="@IrAProyectos" />
        </div>
        <div class="tabla-body">
            @if (proyectosRecientes is not null && proyectosRecientes.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proyecto in proyectosRecientes.Take(5))
                        {
                            <tr>
                                <td>@proyecto.Nombre</td>
                                <td>
                                    <RadzenButton Icon="list_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Class="btn-tabla" Click="@(() => IrAConceptos(proyecto.Id))" title="Conceptos" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align: center; padding: 2rem;">
                    <span class="material-icons" style="font-size: 2.5rem; color: #d1d5db;">folder_open</span>
                    <p class="text-secondary" style="margin-top: 0.5rem;">No hay proyectos creados aún</p>
                    <RadzenButton Text="Crear Proyecto"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@IrACrearProyecto" />
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="gx-card" style="text-align: center; padding: 3rem; margin: 2rem auto; max-width: 500px;">
        <span class="material-icons" style="font-size: 4rem; color: var(--fk-magenta);">account_balance</span>
        <h1 style="margin-top: 0.5rem; color: var(--fk-texto-primario);">FinanKore</h1>
        <p class="text-secondary" style="font-size: 1.1rem;">Gestión financiera inteligente</p>
        <p class="text-secondary">Organiza tus proyecciones, simulaciones, ahorros, deudas y gastos en un solo lugar.</p>

        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
            <RadzenButton Text="Registrarse"
                          Click="@IrARegistrar"
                          ButtonStyle="ButtonStyle.Secondary" />
            <RadzenButton Text="Iniciar Sesión"
                          Click="@IrAIniciarSesion"
                          ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
}

@code {
    private UsuarioRegistradoDto? usuario;
    private bool cargando = true;
    private int totalProyectos;
    private int totalCategorias;
    private int totalReportes;
    private string balanceTotal = "$0";
    private List<ProyectoCreadoDto>? proyectosRecientes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var resultado = await AlmacenamientoSesion.GetAsync<UsuarioRegistradoDto>("usuario_sesion");
            usuario = resultado.Success ? resultado.Value : null;
            Estado.Usuario = usuario;

            if (usuario is not null)
            {
                await CargarDatosDashboard();
            }

            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatosDashboard()
    {
        try
        {
            var proyectos = await ServicioFinanzas.ObtenerProyectosAsync();
            proyectosRecientes = proyectos;
            totalProyectos = proyectosRecientes?.Count ?? 0;

            var categorias = await ServicioFinanzas.ObtenerCategoriasAsync();
            totalCategorias = categorias?.Count ?? 0;

            var reportes = await ServicioFinanzas.ObtenerTodosLosReportesAsync();
            totalReportes = reportes?.Count ?? 0;

            decimal totalEntradas = 0;
            decimal totalSalidas = 0;
            foreach (var p in proyectosRecientes ?? new List<ProyectoCreadoDto>())
            {
                var conceptos = await ServicioFinanzas.ObtenerConceptosAsync(p.Id);
                foreach (var c in conceptos ?? new List<ConceptoCreadoDto>())
                {
                    if (c.Tipo == 1) totalEntradas += c.Valor;
                    else totalSalidas += c.Valor;
                }
            }
            var balance = totalEntradas - totalSalidas;
            balanceTotal = balance >= 0 ? $"+${balance:N0}" : $"-${Math.Abs(balance):N0}";
        }
        catch
        {
            totalProyectos = 0;
            totalCategorias = 0;
            totalReportes = 0;
            balanceTotal = "$0";
        }
    }

    private void IrARegistrar() => Navegacion.NavigateTo("/registrar");
    private void IrAIniciarSesion() => Navegacion.NavigateTo("/iniciar-sesion");
    private void IrAProyectos() => Navegacion.NavigateTo("/finanzas/proyectos");
    private void IrACategorias() => Navegacion.NavigateTo("/finanzas/categorias");
    private void IrAReportes() => Navegacion.NavigateTo("/finanzas/reportes");
    private void IrACrearProyecto() => Navegacion.NavigateTo("/finanzas/proyectos/crear");
    private void IrAConceptos(Guid id) => Navegacion.NavigateTo($"/finanzas/proyectos/{id}/conceptos");

    private async Task CerrarSesion()
    {
        await AlmacenamientoSesion.DeleteAsync("usuario_sesion");
        usuario = null;
        Estado.Usuario = null;
        Navegacion.NavigateTo("/", forceLoad: true);
    }
}
