@page "/finanzas/reportes"
@rendermode InteractiveServer
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Reportes - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem;">
    <h4 style="margin: 0 0 1rem 0;">Filtros</h4>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
        <div style="flex: 1; min-width: 200px;">
            <RadzenLabel Text="Proyecto" Component="FiltroProy" />
            <RadzenDropDown Id="FiltroProy" @bind-Value="proyectoFiltroId"
                            Data="proyectos"
                            TextProperty="Nombre"
                            ValueProperty="Id"
                            AllowClear="true"
                            Placeholder="Todos los proyectos"
                            Style="width: 100%;" />
        </div>
        <div style="flex: 1; min-width: 200px;">
            <RadzenLabel Text="Nombre del reporte" Component="FiltroNom" />
            <RadzenTextBox Id="FiltroNom" @bind-Value="reporteFiltroNombre"
                           Placeholder="Buscar reporte..."
                           Style="width: 100%;" />
        </div>
        <div>
            <RadzenButton Text="Filtrar"
                          Click="@AplicarFiltros"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Medium" />
        </div>
    </div>
</div>

<div class="tabla-container">
    <div class="tabla-header">
        <h3 class="tabla-titulo">
            <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-violeta); vertical-align: middle;">bar_chart</span>
            Reportes
        </h3>
    </div>
    <div class="tabla-body">
        @if (cargando)
        {
            <div style="text-align: center; padding: 2rem;">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                <p class="text-secondary" style="margin-top: 0.75rem;">Cargando reportes...</p>
            </div>
        }
        else if (reportesFiltrados.Count == 0)
        {
            <div style="text-align: center; padding: 3rem;">
                <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">bar_chart</span>
                <p class="text-secondary" style="margin-top: 1rem;">No se encontraron reportes con los filtros aplicados.</p>
            </div>
        }
        else
        {
            <table class="rz-datatable" style="width: 100%;">
                <thead>
                    <tr>
                        <th>Proyecto</th>
                        <th>Reporte</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reporte in reportesFiltrados)
                    {
                        <tr>
                            <td class="text-secondary">@reporte.ProyectoNombre</td>
                            <td><strong>@reporte.ReporteNombre</strong></td>
                            <td style="text-align: right;">
                                <RadzenButton Text="Conceptos"
                                              Click="@(() => IrAConceptos(reporte.Id))"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Icon="receipt_long" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<ReporteListadoDto> reportes = [];
    private List<ReporteListadoDto> reportesFiltrados = [];
    private List<ProyectoCreadoDto> proyectos = [];
    private Guid? proyectoFiltroId;
    private string reporteFiltroNombre = string.Empty;
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            await Task.WhenAll(CargarReportes(), CargarProyectos());
        }
        catch { reportes = []; reportesFiltrados = []; }
        finally { cargando = false; }
    }

    private async Task CargarReportes()
    {
        reportes = await ServicioFinanzas.ObtenerTodosLosReportesAsync();
        reportesFiltrados = reportes.ToList();
    }

    private async Task CargarProyectos() => proyectos = await ServicioFinanzas.ObtenerProyectosAsync();

    private void AplicarFiltros()
    {
        reportesFiltrados = reportes
            .Where(r => !proyectoFiltroId.HasValue || r.ProyectoId == proyectoFiltroId.Value)
            .Where(r => string.IsNullOrWhiteSpace(reporteFiltroNombre) || r.ReporteNombre.Contains(reporteFiltroNombre, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void IrAConceptos(Guid reporteId) => Navegacion.NavigateTo($"/finanzas/reportes/{reporteId}/conceptos");
}
