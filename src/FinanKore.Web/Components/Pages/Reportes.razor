@page "/finanzas/reportes"
@rendermode InteractiveServer
@inject NavigationManager Navegacion

<PageTitle>Reportes - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem; padding: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <span class="material-icons" style="font-size: 2.5rem; color: var(--fk-violeta);">bar_chart</span>
        <div>
            <h2 style="margin: 0;">Reportes</h2>
            <p class="text-secondary" style="margin: 0;">Visualización de resultados financieros</p>
        </div>
    </div>
</div>

<div class="gx-card" style="text-align: center; padding: 3rem; margin-top: 1rem;">
    <span class="material-icons" style="font-size: 3rem; color: var(--rz-text-secondary-color, #bbb);">construction</span>
    <p class="text-secondary" style="margin-top: 1rem;">Reportes próximamente.</p>
</div>

<div style="text-align: left; margin-top: 1rem;">
    <RadzenButton Text="Volver al inicio"
                  ButtonStyle="ButtonStyle.Secondary"
                  Size="ButtonSize.Small"
                  Click="@IrAInicio" />
</div>

@code {
    private void IrAInicio()
    {
        Navegacion.NavigateTo("/");
    }
}
