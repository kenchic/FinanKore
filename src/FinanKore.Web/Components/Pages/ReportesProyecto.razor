@page "/finanzas/proyectos/{proyectoId:guid}/reportes"
@rendermode InteractiveServer
@using FinanKore.Aplicacion.Proyecto.Dtos
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Reportes del Proyecto - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem;">
    <h4 style="margin: 0 0 1rem 0;">Nuevo Reporte</h4>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <RadzenLabel Text="Nombre del reporte" Component="NombreRep" />
        <RadzenTextBox Name="NombreRep" @bind-Value="@modelo.Nombre" Placeholder="Nombre del reporte" Style="width: 100%;" />

        <RadzenLabel Text="Descripción" Component="DescRep" />
        <RadzenTextArea Name="DescRep" @bind-Value="@modelo.Descripcion" Placeholder="Descripción (opcional)" Rows="2" Style="width: 100%;" />

        <RadzenButton Text="Crear Reporte"
                      Click="@HandleCrear"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Medium"
                      Style="width: 100%;" />
    </div>
</div>

<div class="tabla-container">
    <div class="tabla-header">
        <h3 class="tabla-titulo">
            <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-violeta); vertical-align: middle;">bar_chart</span>
            Conceptos en Reportes — @nombreProyecto
        </h3>
    </div>
    <div class="tabla-body">
        @if (cargando)
        {
            <div style="text-align: center; padding: 2rem;">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                <p class="text-secondary" style="margin-top: 0.75rem;">Cargando reportes...</p>
            </div>
        }
        else if (conceptosReporte.Count == 0)
        {
            <div style="text-align: center; padding: 3rem;">
                <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">bar_chart</span>
                <p class="text-secondary" style="margin-top: 1rem;">No hay reportes aún. Creá tu primer reporte arriba.</p>
            </div>
        }
        else
        {
            <div class="pestanas-categorias pestanas-categorias-violeta">
                @foreach (var cat in categoriasUsadas)
                {
                    <button type="button"
                            class="pestana-categoria @(cat.Id == categoriaActivaId ? "activa" : "")"
                            @onclick="@(() => categoriaActivaId = cat.Id)">
                        <span class="material-icons" style="font-size: 0.95rem;">label</span>
                        @cat.Nombre
                        <span class="badge-conteo">@conceptosReporte.Count(c => c.CategoriaId == cat.Id)</span>
                    </button>
                }
            </div>
            <div class="pestana-contenido">
                @{
                    var conceptosDeCat = conceptosReporte.Where(c => c.CategoriaId == categoriaActivaId).OrderBy(c => c.Nombre).ToList();
                    var totalCat = conceptosDeCat.Sum(c => c.Tipo == 1 ? c.Valor : -c.Valor);
                }
                @if (conceptosDeCat.Count == 0)
                {
                    <div style="text-align: center; padding: 2rem;">
                        <span class="material-icons" style="font-size: 2rem; color: #d1d5db;">label_off</span>
                        <p class="text-secondary">Esta categoría no tiene conceptos.</p>
                    </div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th style="text-align: left;">Concepto</th>
                                <th style="text-align: right;">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in conceptosDeCat)
                            {
                                <tr>
                                    <td style="text-align: left; font-weight: 500;">@c.Nombre</td>
                                    <td style="text-align: right;">
                                        <span style="display: inline-flex; align-items: center; gap: 0.35rem; color: @(c.Tipo == 1 ? "var(--fk-verde)" : "var(--fk-magenta)");">
                                            <span class="material-icons" style="font-size: 0.95rem;">@(c.Tipo == 1 ? "trending_up" : "trending_down")</span>
                                            @if (c.Tipo == 1) { <span>$ @c.Valor.ToString("N0")</span> }
                                            else { <span>$ (@c.Valor.ToString("N0"))</span> }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid var(--fk-gris-borde); font-weight: 600;">
                                <td style="text-align: left;">Total</td>
                                <td style="text-align: right; color: @(totalCat >= 0 ? "var(--fk-verde)" : "var(--fk-magenta)");">$ @Math.Abs(totalCat).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProyectoId { get; set; }

    private List<ConceptoReporteDto> conceptosReporte = [];
    private Guid categoriaActivaId;
    private List<CategoriaCreadaDto> categorias = [];
    private List<CategoriaCreadaDto> categoriasUsadas = [];
    private string nombreProyecto = string.Empty;
    private bool cargando = true;
    private CrearReporteModelo modelo = new();

    protected override async Task OnInitializedAsync()
    {
        modelo.ProyectoId = ProyectoId;
        await CargarProyecto();
        await CargarCategorias();
        await CargarReportes();
    }

    private async Task CargarProyecto()
    {
        try { var proyecto = await ServicioFinanzas.ObtenerProyectoPorIdAsync(ProyectoId); nombreProyecto = proyecto?.Nombre ?? "Proyecto"; }
        catch { nombreProyecto = "Proyecto"; }
    }

    private async Task CargarCategorias()
    {
        try { categorias = await ServicioFinanzas.ObtenerCategoriasAsync(); }
        catch { categorias = []; }
    }

    private async Task CargarReportes()
    {
        cargando = true;
        try
        {
            var reportes = await ServicioFinanzas.ObtenerReportesAsync(ProyectoId);
            conceptosReporte = reportes.SelectMany(r => r.Conceptos).ToList();
            CalcularCategoriasUsadas();
            if (categoriaActivaId == Guid.Empty || !categoriasUsadas.Any(c => c.Id == categoriaActivaId))
                categoriaActivaId = categoriasUsadas.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch { conceptosReporte = []; categoriasUsadas = []; categoriaActivaId = Guid.Empty; }
        finally { cargando = false; }
    }

    private void CalcularCategoriasUsadas()
    {
        var idsUsados = conceptosReporte.Select(c => c.CategoriaId).Distinct().ToList();
        categoriasUsadas = categorias.Where(c => idsUsados.Contains(c.Id)).OrderBy(c => c.Nombre).ToList();
    }

    private async Task HandleCrear()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "El nombre del reporte no puede estar vacío.", Duration = 4000 });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearReporteAsync(modelo);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = $"Reporte '{resultado?.Nombre}' creado", Detail = "El reporte se ha creado exitosamente.", Duration = 5000 });
            modelo.Nombre = string.Empty;
            modelo.Descripcion = string.Empty;
            await CargarReportes();
        }
        catch (HttpRequestException ex)
        {
            var codigo = (int?)ex.StatusCode;
            var resumen = codigo.HasValue ? $"Error {(int)codigo} al crear reporte" : "Error al crear reporte";
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = resumen, Detail = ex.Message, Duration = 8000 });
        }
    }
}
