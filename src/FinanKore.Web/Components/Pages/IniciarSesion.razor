@page "/iniciar-sesion"
@rendermode InteractiveServer
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioPerfil ServicioPerfil
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Iniciar Sesión - FinanKore</PageTitle>

<div class="gx-card" style="max-width: 480px; margin: 3rem auto; padding: 2rem;">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <span class="material-icons" style="font-size: 3rem; color: var(--rz-primary);">login</span>
        <h3 style="margin: 0.5rem 0 0.25rem;">Iniciar Sesión</h3>
        <p style="color: var(--rz-text-secondary); margin: 0;">Ingresa tus credenciales para acceder</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <RadzenTextBox @bind-Value="@modelo.Correo"
                       Placeholder="tu@correo.com"
                       Style="width: 100%;" />

        <RadzenPassword @bind-Value="@modelo.Password"
                        Placeholder="Contraseña"
                        Style="width: 100%;" />

        <RadzenButton Text="Iniciar Sesión"
                      Click="@HandleIniciarSesion"
                      ButtonStyle="@ButtonStyle.Primary"
                      Size="@ButtonSize.Medium"
                      Style="width: 100%;" />
    </div>

    <div style="text-align: center; margin-top: 1rem;">
        <RadzenButton Text="¿No tienes cuenta? Regístrate"
                      ButtonStyle="@ButtonStyle.Info"
                      Size="@ButtonSize.Small"
                      Click="@IrARegistrar" />
    </div>
</div>

@code {
    private IniciarSesionModelo modelo = new();

    private void IrARegistrar()
    {
        Navegacion.NavigateTo("/registrar");
    }

    private async Task HandleIniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(modelo.Correo))
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Correo obligatorio",
                Duration = 4000
            });
            return;
        }

        if (string.IsNullOrWhiteSpace(modelo.Password))
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Contraseña obligatoria",
                Duration = 4000
            });
            return;
        }

        try
        {
            var resultado = await ServicioPerfil.IniciarSesionAsync(modelo);

            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"¡Bienvenido {resultado?.NombreCompleto ?? "usuario"}!",
                Detail = "Has iniciado sesión exitosamente.",
                Duration = 5000
            });

            Navegacion.NavigateTo("/");
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al iniciar sesión",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }
}