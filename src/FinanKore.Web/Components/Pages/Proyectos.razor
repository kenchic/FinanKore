@page "/finanzas/proyectos"
@rendermode InteractiveServer
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NavigationManager Navegacion

<PageTitle>Proyectos - FinanKore</PageTitle>

<div class="tabla-container">
    <div class="tabla-header">
        <h3 class="tabla-titulo">
            <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-magenta); vertical-align: middle;">folder</span>
            Proyectos
        </h3>
        <RadzenButton Text="Nuevo Proyecto" Click="@CrearProyecto" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
    </div>
    <div class="tabla-body">
        @if (cargando)
        {
            <div style="text-align: center; padding: 2rem;">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                <p class="text-secondary" style="margin-top: 0.75rem;">Cargando proyectos...</p>
            </div>
        }
        else if (proyectos.Count == 0)
        {
            <div style="text-align: center; padding: 3rem;">
                <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">folder_open</span>
                <p class="text-secondary" style="margin-top: 1rem;">No hay proyectos aún. Creá tu primer proyecto para empezar.</p>
                <RadzenButton Text="Crear Proyecto" Click="@CrearProyecto" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
            </div>
        }
        else
        {
            <table class="rz-datatable" style="width: 100%;">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proyecto in proyectos)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <span class="material-icons" style="color: var(--fk-magenta); font-size: 1.25rem;">folder</span>
                                    <strong style="cursor: pointer;" @onclick="() => IrAReportes(proyecto.Id)">@proyecto.Nombre</strong>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <RadzenButton Text="Conceptos"
                                              Click="() => IrAConceptos(proyecto.Id)"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Style="margin-right: 0.5rem;" />
                                <RadzenButton Text="Reportes"
                                              Click="() => IrAReportes(proyecto.Id)"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<ProyectoCreadoDto> proyectos = [];
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try { proyectos = await ServicioFinanzas.ObtenerProyectosAsync(); }
        catch { proyectos = []; }
        finally { cargando = false; }
    }

    private void CrearProyecto() => Navegacion.NavigateTo("/finanzas/proyectos/crear");
    private void IrAConceptos(Guid id) => Navegacion.NavigateTo($"/finanzas/proyectos/{id}/conceptos");
    private void IrAReportes(Guid id) => Navegacion.NavigateTo($"/finanzas/proyectos/{id}/reportes");
}
