@page "/finanzas/proyectos/crear"
@rendermode InteractiveServer
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Crear Proyecto - FinanKore</PageTitle>

<div class="gx-card" style="max-width: 520px;">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <span class="material-icons" style="font-size: 3rem; color: var(--fk-magenta);">create_new_folder</span>
        <h3 style="margin: 0.5rem 0 0.25rem;">Crear Proyecto</h3>
        <p class="text-secondary" style="margin: 0;">Crea un nuevo proyecto financiero</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <RadzenLabel Text="Nombre del proyecto" Component="Nombre" />
        <RadzenTextBox @bind-Value="@modelo.Nombre"
                       Placeholder="Ej: Ahorro para vacaciones"
                       Style="width: 100%;" />

        <RadzenButton Text="Crear Proyecto"
                      Click="@HandleCrear"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Medium"
                      Style="width: 100%;" />
    </div>
</div>

@code {
    private CrearProyectoModelo modelo = new();

    private async Task HandleCrear()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "El nombre del proyecto no puede estar vacío.", Duration = 4000 });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearProyectoAsync(modelo);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = $"Proyecto '{resultado?.Nombre}' creado", Detail = "El proyecto se ha creado exitosamente.", Duration = 5000 });
            Navegacion.NavigateTo("/finanzas/proyectos");
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al crear proyecto", Detail = ex.Message, Duration = 5000 });
        }
    }
}
