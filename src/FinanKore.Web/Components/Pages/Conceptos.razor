@page "/finanzas/conceptos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using FinanKore.Web.Models
@using FinanKore.Web.Servicios
@inject ServicioFinanzas ServicioFinanzas
@inject NotificationService Notificacion
@inject NavigationManager Navegacion

<PageTitle>Conceptos - FinanKore</PageTitle>

<div class="gx-card" style="margin-bottom: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <span class="material-icons" style="color: var(--fk-texto-secundario);">folder</span>
        @if (circuitoConectado)
        {
            <RadzenDropDown Data="@proyectos"
                            TextProperty="Nombre"
                            ValueProperty="Id"
                            @bind-Value="@proyectoSeleccionadoId"
                            Placeholder="Seleccionar proyecto..."
                            Change="@OnProyectoCambiado"
                            Style="width: 100%; max-width: 400px;" />
        }
        else
        {
            <span class="text-secondary">Cargando proyectos...</span>
        }
    </div>
</div>

@if (proyectoSeleccionadoId == Guid.Empty)
{
    <div class="gx-card" style="text-align: center; padding: 3rem;">
        <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">info</span>
        <p class="text-secondary" style="margin-top: 1rem;">Seleccioná un proyecto para ver sus conceptos.</p>
    </div>
}
else
{
    <div class="tabla-container">
        <div class="tabla-header">
            <h3 class="tabla-titulo">
                <span class="material-icons" style="margin-right: 0.5rem; color: var(--fk-violeta); vertical-align: middle;">receipt_long</span>
                Conceptos — @nombreProyectoSeleccionado
            </h3>
            <RadzenButton Text="Nuevo Concepto" Click="@MostrarFormulario" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
        </div>
        <div class="tabla-body">
            @if (mostrandoFormulario)
            {
                <div style="padding: 1.5rem; max-width: 520px;">
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <RadzenLabel Text="Nombre" Component="NombreCon" />
                        <RadzenTextBox Name="NombreCon" @bind-Value="@modelo.Nombre" Placeholder="Nombre del concepto" Style="width: 100%;" />

                        <RadzenLabel Text="Valor ($)" Component="ValorCon" />
                        <RadzenNumeric Name="ValorCon" @bind-Value="@modelo.Valor" Min="0" Format="c" Style="width: 100%;" />

                        <RadzenLabel Text="Tipo" Component="TipoCon" />
                        <RadzenDropDown Name="TipoCon" Data="@tiposMovimiento" TextProperty="Texto" ValueProperty="Valor" @bind-Value="@modelo.Tipo" Placeholder="Tipo de movimiento..." Style="width: 100%;" />

                        <RadzenLabel Text="Categoría" Component="CatCon" />
                        <RadzenDropDown Name="CatCon" Data="@categorias" TextProperty="Nombre" ValueProperty="Id" @bind-Value="@modelo.CategoriaId" Placeholder="Seleccionar categoría..." Style="width: 100%;" />

                        <div style="display: flex; gap: 0.5rem;">
                            <RadzenButton Text="Guardar" Click="@HandleCrear" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Style="flex: 1;" />
                            <RadzenButton Text="Cancelar" Click="@CancelarFormulario" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Style="flex: 1;" />
                        </div>
                    </div>
                </div>
            }
            else if (cargando)
            {
                <div style="text-align: center; padding: 2rem;">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 36px; height: 36px;" />
                    <p class="text-secondary" style="margin-top: 0.75rem;">Cargando conceptos...</p>
                </div>
            }
            else if (conceptos.Count == 0)
            {
                <div style="text-align: center; padding: 3rem;">
                    <span class="material-icons" style="font-size: 3rem; color: #d1d5db;">receipt_long</span>
                    <p class="text-secondary" style="margin-top: 1rem;">No hay conceptos en este proyecto. ¡Creá el primero!</p>
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Valor</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var concepto in conceptos)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        @if (concepto.Valor > 0)
                                        {
                                            <span class="material-icons" style="color: @(concepto.Tipo == 1 ? "var(--fk-verde)" : "var(--fk-magenta)"); font-size: 0.9rem;">
                                                @(concepto.Tipo == 1 ? "trending_up" : "trending_down")
                                            </span>
                                        }
                                        <span>@concepto.Nombre</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-estado @(concepto.Tipo == 1 ? "badge-entrada" : "badge-salida")">
                                        @(concepto.Tipo == 1 ? "Entrada" : "Salida")
                                    </span>
                                </td>
                                @if (concepto.Valor > 0)
                                {
                                    <td><strong>@concepto.Valor.ToString("C")</strong></td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                <td class="text-secondary">@concepto.FechaCreacion.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<ProyectoCreadoDto> proyectos = [];
    private List<ConceptoCreadoDto> conceptos = [];
    private List<CategoriaCreadaDto> categorias = [];
    private Guid proyectoSeleccionadoId = Guid.Empty;
    private string nombreProyectoSeleccionado = string.Empty;
    private bool cargando;
    private bool mostrandoFormulario;
    private bool circuitoConectado;
    private CrearConceptoModelo modelo = new() { Nombre = string.Empty, Valor = 0, Tipo = 1 };

    private List<TipoMovimientoOpcion> tiposMovimiento = [new(1, "Entrada"), new(2, "Salida")];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            proyectos = await ServicioFinanzas.ObtenerProyectosAsync();
            categorias = await ServicioFinanzas.ObtenerCategoriasAsync();
        }
        catch { proyectos = []; categorias = []; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !circuitoConectado)
        {
            await Task.Delay(300);
            circuitoConectado = true;
            StateHasChanged();
        }
    }

    private async Task OnProyectoCambiado()
    {
        mostrandoFormulario = false;
        var proyecto = proyectos.FirstOrDefault(p => p.Id == proyectoSeleccionadoId);
        nombreProyectoSeleccionado = proyecto?.Nombre ?? string.Empty;
        if (proyectoSeleccionadoId == Guid.Empty) { conceptos = []; return; }
        await CargarConceptos();
    }

    private async Task CargarConceptos()
    {
        cargando = true;
        try { conceptos = await ServicioFinanzas.ObtenerConceptosAsync(proyectoSeleccionadoId); }
        catch { conceptos = []; }
        finally { cargando = false; }
    }

    private void MostrarFormulario()
    {
        modelo = new CrearConceptoModelo { ProyectoId = proyectoSeleccionadoId, Nombre = string.Empty, Valor = 0, Tipo = 1 };
        mostrandoFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        modelo = new CrearConceptoModelo { Nombre = string.Empty, Valor = 0, Tipo = 1 };
    }

    private async Task HandleCrear()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Nombre obligatorio", Detail = "El concepto debe tener un nombre.", Duration = 4000 });
            return;
        }
        if (modelo.Valor < 0)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Valor inválido", Detail = "El valor no puede ser negativo.", Duration = 4000 });
            return;
        }
        if (modelo.CategoriaId == Guid.Empty)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Categoría obligatoria", Detail = "Debés seleccionar una categoría.", Duration = 4000 });
            return;
        }

        try
        {
            var resultado = await ServicioFinanzas.CrearConceptoAsync(modelo);
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = $"Concepto '{resultado?.Nombre}' creado", Detail = "El concepto se ha creado exitosamente.", Duration = 5000 });
            mostrandoFormulario = false;
            modelo = new CrearConceptoModelo { Nombre = string.Empty, Valor = 0, Tipo = 1 };
            await CargarConceptos();
        }
        catch (HttpRequestException ex)
        {
            Notificacion.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error al crear concepto", Detail = ex.Message, Duration = 5000 });
        }
    }

    private sealed record TipoMovimientoOpcion(int Valor, string Texto);
}
