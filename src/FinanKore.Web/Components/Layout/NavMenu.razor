@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@rendermode InteractiveServer
@inject ProtectedSessionStorage AlmacenamientoSesion
@inject NavigationManager Navegacion
@inject EstadoAutenticacion Estado
@inject IJSRuntime JS
@inject ServicioConfiguracion ServicioConfiguracion
@inject EstadoSidebar EstadoSidebar
@implements IDisposable

<aside class="sidebar @(estadoColapsado ? "colapsado" : "")">
    <div class="sidebar-brand">
        <span class="material-icons sidebar-brand-icon">account_balance</span>
        <span class="sidebar-brand-text">FinanKore</span>
        <button class="sidebar-toggle" @onclick="AlternarSidebar" title="@(estadoColapsado ? "Expandir menú" : "Colapsar menú")">
            <span class="material-icons">@(estadoColapsado ? "chevron_right" : "chevron_left")</span>
        </button>
    </div>

    <nav class="sidebar-nav">
        @if (autenticado)
        {
            <NavLink href="/" Match="NavLinkMatch.All" class="sidebar-nav-item">
                <span class="material-icons">dashboard</span>
                <span>Inicio</span>
            </NavLink>
            <NavLink href="/finanzas/categorias" class="sidebar-nav-item">
                <span class="material-icons">category</span>
                <span>Categorías</span>
            </NavLink>
            <NavLink href="/finanzas/proyectos" class="sidebar-nav-item">
                <span class="material-icons">folder</span>
                <span>Proyectos</span>
            </NavLink>
            <NavLink href="/finanzas/reportes" class="sidebar-nav-item">
                <span class="material-icons">bar_chart</span>
                <span>Reportes</span>
            </NavLink>

            <div class="sidebar-divider"></div>

            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    <span class="material-icons">person</span>
                </div>
                <div class="sidebar-user-info">
                    <span class="sidebar-user-name">@usuarioNombre</span>
                    <span class="sidebar-user-email">@usuarioCorreo</span>
                </div>
            </div>

            <button class="sidebar-logout" @onclick="CerrarSesion">
                <span class="material-icons">logout</span>
                <span>Cerrar Sesión</span>
            </button>
        }
        else
        {
            <NavLink href="/iniciar-sesion" class="sidebar-nav-item">
                <span class="material-icons">login</span>
                <span>Iniciar Sesión</span>
            </NavLink>
            <NavLink href="/registrar" class="sidebar-nav-item">
                <span class="material-icons">person_add</span>
                <span>Registrarse</span>
            </NavLink>
        }

        <div class="sidebar-divider"></div>

        <button class="sidebar-theme-toggle" @onclick="AlternarTema">
            <span class="material-icons">@(temaOscuro ? "light_mode" : "dark_mode")</span>
            <span>@(temaOscuro ? "Modo Claro" : "Modo Oscuro")</span>
        </button>
    </nav>
</aside>

@code {
    private bool autenticado;
    private bool estadoColapsado;
    private bool temaOscuro;
    private bool _temaCargado;
    private string usuarioNombre = string.Empty;
    private string usuarioCorreo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Navegacion.LocationChanged += OnLocationChanged;
        Estado.AlCambiarEstado += OnEstadoAutenticacionCambio;
        EstadoSidebar.AlCambiar += OnEstadoSidebarCambio;
        await VerificarSesionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_temaCargado)
        {
            await IntentarCargarTemaAsync();
            if (_temaCargado)
            {
                StateHasChanged();
            }
        }
        if (firstRender)
        {
            try
            {
                var raw = await JS.InvokeAsync<string>("localStorage.getItem", EstadoSidebar.StorageKey);
                if (bool.TryParse(raw, out var colapsado))
                {
                    EstadoSidebar.Colapsado = colapsado;
                    estadoColapsado = colapsado;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async void OnEstadoAutenticacionCambio()
    {
        await InvokeAsync(async () =>
        {
            await VerificarSesionAsync();
            await IntentarCargarTemaAsync();
            StateHasChanged();
        });
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await VerificarSesionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task VerificarSesionAsync()
    {
        if (Estado.Usuario is not null)
        {
            autenticado = true;
            usuarioNombre = Estado.Usuario.NombreCompleto;
            usuarioCorreo = Estado.Usuario.Correo;
            return;
        }

        try
        {
            var resultado = await AlmacenamientoSesion.GetAsync<UsuarioRegistradoDto>("usuario_sesion");
            autenticado = resultado.Success && resultado.Value is not null;
            if (autenticado)
            {
                usuarioNombre = resultado.Value!.NombreCompleto;
                usuarioCorreo = resultado.Value!.Correo;
                Estado.Usuario = resultado.Value;
            }
            else
            {
                usuarioNombre = string.Empty;
                usuarioCorreo = string.Empty;
            }
        }
        catch
        {
            autenticado = false;
            usuarioNombre = string.Empty;
            usuarioCorreo = string.Empty;
        }
    }

    private async Task IntentarCargarTemaAsync()
    {
        try
        {
            await CargarTemaAsync();
            _temaCargado = true;
        }
        catch (InvalidOperationException)
        {
            // JS interop no disponible durante prerenderizado estático.
            // Se reintentará cuando se dispare OnEstadoAutenticacionCambio
            // o en el siguiente render interactivo.
        }
    }

    private async Task CargarTemaAsync()
    {
        var tema = await JS.InvokeAsync<string>("eval", "fkTema.obtenerTema()");
        temaOscuro = tema == "dark";

        if (autenticado && Estado.Usuario is not null)
        {
            try
            {
                var preferencias = await ServicioConfiguracion.ObtenerPreferenciasAsync(Estado.Usuario.Id);
                if (preferencias is not null)
                {
                    var temaFromDb = string.Equals(preferencias.Tema, "Oscuro", StringComparison.OrdinalIgnoreCase) ? "dark" : "light";
                    if (tema != temaFromDb)
                    {
                        await ServicioConfiguracion.CambiarTemaAsync(Estado.Usuario.Id, tema == "dark" ? "Oscuro" : "Claro");
                    }
                }
            }
            catch
            {
                // Si falla la API, el cookie sigue como fuente de verdad
            }
        }
    }

    private void OnEstadoSidebarCambio()
    {
        estadoColapsado = EstadoSidebar.Colapsado;
        InvokeAsync(StateHasChanged);
    }

    private async Task AlternarSidebar()
    {
        EstadoSidebar.Alternar();
        try { await JS.InvokeVoidAsync("localStorage.setItem", EstadoSidebar.StorageKey, EstadoSidebar.Colapsado ? "true" : "false"); }
        catch { }
    }

    private async Task AlternarTema()
    {
        var nuevoTema = await JS.InvokeAsync<string>("eval", "fkTema.alternarTema()");
        temaOscuro = nuevoTema == "dark";

        if (autenticado && Estado.Usuario is not null)
        {
            try
            {
                await ServicioConfiguracion.CambiarTemaAsync(Estado.Usuario.Id, nuevoTema == "dark" ? "Oscuro" : "Claro");
            }
            catch
            {
                // Si falla la API, el tema ya está guardado en cookie
            }
        }
    }

    private async Task CerrarSesion()
    {
        Estado.Usuario = null;
        await AlmacenamientoSesion.DeleteAsync("usuario_sesion");
        autenticado = false;
        usuarioNombre = string.Empty;
        usuarioCorreo = string.Empty;
        Navegacion.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= OnLocationChanged;
        Estado.AlCambiarEstado -= OnEstadoAutenticacionCambio;
        EstadoSidebar.AlCambiar -= OnEstadoSidebarCambio;
    }
}
