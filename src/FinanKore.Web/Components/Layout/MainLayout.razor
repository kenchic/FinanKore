@inherits LayoutComponentBase
@inject EstadoSidebar EstadoSidebar
@implements IDisposable

<div class="layout-dashboard">
    <NavMenu />
    <div class="layout-content @(EstadoSidebar.Colapsado ? "layout-content-colapsado" : "")">
        <header class="layout-header">
            <div class="layout-header-left">
                <h1 class="layout-header-title">@TituloPagina</h1>
            </div>
            <div class="layout-header-right">
                <SectionOutlet SectionName="AccionesPagina" />
            </div>
        </header>
        <main class="layout-main">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private string TituloPagina => "FinanKore";

    protected override void OnInitialized()
    {
        EstadoSidebar.AlCambiar += OnSidebarCambio;
    }

    private void OnSidebarCambio()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EstadoSidebar.AlCambiar -= OnSidebarCambio;
    }
}
